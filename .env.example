# Copy to .env and adjust. Every value here is also the built-in default, so
# the stack runs with no .env file at all.

# ---- API ----

# Port the Go server listens on.
PORT=8080

# Blank uses a local SQLite file (api/data/taskmania.db), which needs no setup.
# For PostgreSQL:
#   DATABASE_URL=postgres://taskmania:taskmania@localhost:5432/taskmania?sslmode=disable
# On Railway, share Postgres.DATABASE_URL onto the API service.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API. Only these are
# echoed back, so a wildcard cannot slip into a deployment by accident.
# Production: the Vercel origin, e.g. https://taskmania.vercel.app
CORS_ORIGINS=http://localhost:5173

# Structured JSON logs instead of human-readable text.
LOG_JSON=false

# ---- Frontend ----

# Where the browser sends API calls. Leave unset in development so requests go
# to /api and the Vite dev proxy forwards them to the Go server.
# On Vercel, set this to the Railway public API URL (no trailing slash):
# VITE_API_BASE=https://YOUR-API.up.railway.app
